---
import { CORE_REPO } from '../data/source';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<header class="header">
  <div class="header-inner">
    <a href={`${base}`} class="logo">
      <img src={`${base}icon.png`} alt="Pear Notes" />
      Pear Notes
    </a>
    <button class="mobile-menu-btn" aria-label="Toggle menu">☰</button>
    <nav>
      <ul class="nav-links">
        <li><a href={`${base}#features`}>Features</a></li>
        <li><a href={`${base}#ai`}>AI</a></li>
        <li><a href={`${base}#tour`}>Tour</a></li>
        <li><a href={`${base}#security`}>Security</a></li>
        <li><a href={`${base}faq/`}>FAQ</a></li>
        <li><a href={`${base}contact/`}>Contact</a></li>
        <li><a href={CORE_REPO} target="_blank" rel="noopener noreferrer" class="nav-source"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>Source</a></li>
        <li><a href={`${base}#download`} class="nav-cta">Download</a></li>
      </ul>
    </nav>
  </div>
</header>
