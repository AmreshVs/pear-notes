---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Pear Notes is a secure, private, and offline-first notebook. End-to-end encrypted with peer-to-peer sync across all your devices. No servers, no cloud leaks.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const ogImage = new URL(`${base}og-image.png`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e0e10" />
    <link rel="icon" type="image/png" href={`${base}icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>

    <!-- Google Analytics (Anonymous/Traffic Only) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-X24NHKRC5E"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      // Disable advertising features to respect privacy
      gtag('set', 'allow_ad_personalization_signals', false);
      
      gtag('config', 'G-X24NHKRC5E', {
        'anonymize_ip': true
      });
    </script>
  </head>
  <body>
    <slot />
    <script>
      const header = document.querySelector('.header');
      if (header) {
        window.addEventListener('scroll', () => {
          header.classList.toggle('scrolled', window.scrollY > 40);
        });
      }

      const menuBtn = document.querySelector('.mobile-menu-btn');
      const navLinks = document.querySelector('.nav-links');
      if (menuBtn && navLinks) {
        menuBtn.setAttribute('aria-expanded', 'false');
        menuBtn.addEventListener('click', () => {
          const open = navLinks.classList.toggle('open');
          menuBtn.textContent = open ? '✕' : '☰';
          menuBtn.setAttribute('aria-expanded', String(open));
        });
        navLinks.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            navLinks.classList.remove('open');
            menuBtn.textContent = '☰';
            menuBtn.setAttribute('aria-expanded', 'false');
          });
        });
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );

      document.querySelectorAll('.fade-in').forEach((el) => observer.observe(el));

      // Active nav link highlighting — page-based (privacy, terms)
      document.querySelectorAll<HTMLAnchorElement>('.nav-links a:not([href*="#"])').forEach(a => {
        const linkPath = new URL(a.href).pathname;
        if (linkPath !== '/' && window.location.pathname === linkPath) {
          a.classList.add('nav-active');
        }
      });

      // Active nav link highlighting — hash-based (sections)
      const navAnchors = document.querySelectorAll<HTMLAnchorElement>('.nav-links a[href*="#"]');
      const sections = Array.from(navAnchors)
        .map(a => {
          const id = a.getAttribute('href')!.split('#')[1];
          return id ? document.getElementById(id) : null;
        })
        .filter(Boolean) as HTMLElement[];

      const setActiveLink = (id: string) => {
        navAnchors.forEach(a => {
          const href = a.getAttribute('href') ?? '';
          a.classList.toggle('nav-active', href.includes(`#${id}`));
        });
      };

      const sectionObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) setActiveLink(entry.target.id);
          });
        },
        { rootMargin: '-40% 0px -55% 0px', threshold: 0 }
      );

      sections.forEach(s => sectionObserver.observe(s));

      document.querySelectorAll('.tour-list').forEach(list => {
        const wrap = list.closest('.tour-list-wrap');
        if (!wrap) return;
        const check = () => {
          const atTop = list.scrollTop < 8;
          const atBottom = list.scrollHeight - list.scrollTop - list.clientHeight < 8;
          wrap.classList.toggle('scrolled-top', !atTop);
          wrap.classList.toggle('at-bottom', atBottom);
        };
        check();
        list.addEventListener('scroll', check);
      });

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // <details> opens and closes instantly on its own, so drive the panel
      // height ourselves. Closing is deferred until the animation finishes,
      // otherwise the content would vanish before it could collapse.
      document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach(details => {
        const summary = details.querySelector('summary');
        const panel = details.querySelector<HTMLElement>('.faq-answer');
        if (!summary || !panel) return;

        let animation: Animation | null = null;
        let closing = false;

        summary.addEventListener('click', event => {
          if (prefersReducedMotion) return;
          event.preventDefault();

          // Measured before cancelling, so an interrupted animation resumes
          // from where it actually is instead of snapping.
          const from = panel.offsetHeight;
          animation?.cancel();

          // Mid-collapse the element is still `open`, but the intent is to reopen.
          if (details.open && !closing) {
            closing = true;
            animation = panel.animate(
              { height: [`${from}px`, '0px'], opacity: [1, 0] },
              { duration: 220, easing: 'cubic-bezier(0.4, 0, 0.2, 1)' }
            );
            animation.onfinish = () => {
              details.open = false;
              closing = false;
              animation = null;
            };
          } else {
            details.open = true;
            closing = false;
            const to = panel.offsetHeight;
            animation = panel.animate(
              { height: [`${from}px`, `${to}px`], opacity: [to ? from / to : 0, 1] },
              { duration: 260, easing: 'cubic-bezier(0.4, 0, 0.2, 1)' }
            );
            animation.onfinish = () => {
              animation = null;
            };
          }
        });
      });

      document.querySelectorAll<HTMLElement>('[data-tour]').forEach(section => {
        type DeviceKind = 'mobile' | 'desktop';

        const deviceBtns = Array.from(
          section.querySelectorAll<HTMLElement>('[data-tour-device]')
        );
        let device: DeviceKind =
          (deviceBtns[0]?.getAttribute('data-tour-device') as DeviceKind) ?? 'mobile';

        const itemsFor = (kind: DeviceKind) =>
          Array.from(section.querySelectorAll<HTMLElement>(`[data-tour-pick="${kind}"]`));
        const listFor = (kind: DeviceKind) =>
          section.querySelector<HTMLElement>(`[data-tour-list="${kind}"] .tour-list`);

        function select(kind: DeviceKind, index: number) {
          itemsFor(kind).forEach(item => {
            const on = Number(item.dataset.index) === index;
            item.classList.toggle('active', on);
            item.setAttribute('aria-pressed', String(on));
          });

          section
            .querySelectorAll<HTMLElement>(`[data-tour-pane="${kind}"] .tour-screen`)
            .forEach(screen => {
              const on = Number(screen.dataset.index) === index;
              screen.classList.toggle('active', on);
              // Restart the entrance animation on every swap.
              if (on) {
                screen.classList.remove('tour-screen-in');
                void screen.offsetWidth;
                screen.classList.add('tour-screen-in');
              }
            });
        }

        function scrollListTo(kind: DeviceKind, item: HTMLElement) {
          const list = listFor(kind);
          if (!list) return;
          list.scrollTo({
            top: item.offsetTop - list.offsetTop - list.clientHeight / 2 + item.clientHeight / 2,
            behavior: prefersReducedMotion ? 'auto' : 'smooth',
          });
        }

        function setDevice(kind: DeviceKind) {
          device = kind;
          deviceBtns.forEach(btn => {
            const on = btn.getAttribute('data-tour-device') === kind;
            btn.classList.toggle('active', on);
            btn.setAttribute('aria-pressed', String(on));
          });
          section.querySelectorAll<HTMLElement>('[data-tour-list]').forEach(el => {
            el.hidden = el.getAttribute('data-tour-list') !== kind;
          });
          section.querySelectorAll<HTMLElement>('[data-tour-pane]').forEach(el => {
            el.hidden = el.getAttribute('data-tour-pane') !== kind;
          });
        }

        (['mobile', 'desktop'] as DeviceKind[]).forEach(kind => {
          itemsFor(kind).forEach(item => {
            item.setAttribute('aria-pressed', String(item.classList.contains('active')));
            item.addEventListener('click', () => {
              select(kind, Number(item.dataset.index));
              item.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            });
          });
        });

        deviceBtns.forEach(btn => {
          btn.setAttribute('aria-pressed', String(btn.classList.contains('active')));
          btn.addEventListener('click', () =>
            setDevice(btn.getAttribute('data-tour-device') as DeviceKind)
          );
        });

        let autoTimer: ReturnType<typeof setInterval> | null = null;
        let userInteracted = false;
        let sectionInView = false;

        function stopAuto() {
          if (autoTimer) {
            clearInterval(autoTimer);
            autoTimer = null;
          }
        }

        function startAuto() {
          if (userInteracted || prefersReducedMotion || autoTimer) return;
          if (!sectionInView || document.visibilityState === 'hidden') return;
          autoTimer = setInterval(() => {
            const items = itemsFor(device);
            if (items.length === 0) return;
            const current = items.findIndex(i => i.classList.contains('active'));
            const next = (current + 1) % items.length;
            select(device, next);
            scrollListTo(device, items[next]);
          }, 4000);
        }

        section.addEventListener('pointerdown', () => {
          userInteracted = true;
          stopAuto();
        });

        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'hidden') stopAuto();
          else startAuto();
        });

        const autoObserver = new IntersectionObserver(
          entries => {
            entries.forEach(entry => {
              sectionInView = entry.isIntersecting;
              if (entry.isIntersecting) startAuto();
              else stopAuto();
            });
          },
          { threshold: 0.35 }
        );
        autoObserver.observe(section);
      });
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
