---
interface Props {
  title: string;
  description?: string;
  /** Browser chrome tint (status bar on older iOS Safari). */
  themeColor?: string;
}

const { title, themeColor = '#0e0e10', description = 'Pear Notes is a secure, private, and offline-first notebook. End-to-end encrypted with peer-to-peer sync across all your devices. No servers, no cloud leaks.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site).href;
const ogImage = new URL(`${base}og-image.png`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/png" href={`${base}icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Pear Notes" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Pear Notes',
      description,
      applicationCategory: 'ProductivityApplication',
      operatingSystem: 'Android, iOS, Windows, macOS, Linux',
      url: new URL(base, Astro.site).href,
      image: ogImage.href,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    })} />

    <!-- Anonymous analytics: Google Analytics 4, no cookies, no ad features. Skipped entirely
         for visitors who send Do Not Track or Global Privacy Control, and on local dev. -->
    <script>
      const w = window as any;
      const optedOut =
        navigator.doNotTrack === '1' ||
        w.doNotTrack === '1' ||
        w.globalPrivacyControl === true ||
        (navigator as any).globalPrivacyControl === true;
      const local = ['localhost', '127.0.0.1', '[::1]'].includes(location.hostname);

      w.dataLayer = w.dataLayer || [];
      if (optedOut || local) {
        w.gtag = function () {};
      } else {
        w.gtag = function () { w.dataLayer.push(arguments); };
        const tag = document.createElement('script');
        tag.async = true;
        tag.src = 'https://www.googletagmanager.com/gtag/js?id=G-X24NHKRC5E';
        document.head.appendChild(tag);

        w.gtag('js', new Date());
        w.gtag('config', 'G-X24NHKRC5E', {
          client_storage: 'none',
          allow_google_signals: false,
          allow_ad_personalization_signals: false,
        });
      }
    </script>
  </head>
  <body>
    <slot />
    <script>
      // Click and section analytics. Events carry only what the site itself defines (which
      // button, which section, which platform); never page text typed by a visitor, never a
      // query string, never an identifier.
      const track = (name: string, params: Record<string, string | number | boolean> = {}) => {
        try { (window as any).gtag?.('event', name, params); } catch {}
      };

      const STORES: Record<string, string> = {
        'play.google.com': 'google_play',
        'apps.apple.com': 'app_store',
        'apps.microsoft.com': 'microsoft_store',
        'github.com': 'github_release',
      };

      // Where on the page a click happened, so "Get Pear Notes" in the hero can be told
      // apart from the one in the header or the phone bar.
      const placementOf = (el: Element): string => {
        if (el.closest('.header')) return 'header';
        if (el.closest('.footer')) return 'footer';
        if (el.closest('.mobile-cta')) return 'mobile_bar';
        if (el.closest('#download-all')) return 'download_other_platforms';
        return el.closest('section[id]')?.id ?? 'page';
      };

      document.addEventListener('click', (event) => {
        const target = event.target as Element | null;
        if (!target?.closest) return;

        const link = target.closest<HTMLAnchorElement>('a[href]');
        if (link) {
          const placement = placementOf(link);
          const url = new URL(link.href, location.href);
          const dl = link.closest<HTMLElement>('[data-track-download]');
          if (dl) {
            track('download_click', {
              platform: dl.dataset.trackDownload ?? 'unknown',
              store: STORES[url.hostname] ?? url.hostname,
              label: dl.dataset.trackLabel ?? 'primary',
              placement,
            });
          } else if (url.origin !== location.origin) {
            track('outbound_click', { link_domain: url.hostname, link_path: url.pathname, placement });
          } else if (url.hash === '#download') {
            track('cta_click', { cta: (link.textContent ?? '').trim().slice(0, 40), placement });
          } else {
            const root = import.meta.env.BASE_URL.replace(/\/$/, '');
            track('nav_click', { link: (url.pathname + url.hash).slice(root.length) || '/', placement });
          }
          return;
        }

        const toggle = target.closest('#download-toggle');
        if (toggle) {
          // aria-expanded still holds the state from before this click.
          track('download_toggle', { action: toggle.getAttribute('aria-expanded') === 'true' ? 'close' : 'open' });
          return;
        }

        const device = target.closest<HTMLElement>('[data-tour-device]');
        if (device) { track('tour_device', { device: device.dataset.tourDevice ?? '' }); return; }

        const pick = target.closest<HTMLElement>('[data-tour-pick]');
        if (pick) {
          track('tour_feature', {
            device: pick.dataset.tourPick ?? '',
            feature: pick.querySelector('.tour-item-title')?.textContent?.trim() ?? '',
          });
          return;
        }

        const summary = target.closest('.faq-item > summary');
        if (summary && !(summary.parentElement as HTMLDetailsElement).open) {
          track('faq_open', { question: (summary.textContent ?? '').trim().replace(/\s+/g, ' ').slice(0, 100) });
          return;
        }

        const film = target.closest<HTMLElement>('[data-hero-film-sound],[data-hero-film-skip],[data-hero-film-replay]');
        if (film) {
          const action = film.hasAttribute('data-hero-film-sound') ? 'sound'
            : film.hasAttribute('data-hero-film-skip') ? 'skip' : 'replay';
          track('hero_film', { action });
        }
        // Capture phase: runs before the page's own handlers change the state read above
        // (FAQ open/closed, download list expanded).
      }, true);

      // Funnel depth: each section the visitor reaches, reported once per page view.
      const seen = new Set<string>();
      const sectionViews = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const id = entry.target.id;
            if (!entry.isIntersecting || seen.has(id)) return;
            seen.add(id);
            sectionViews.unobserve(entry.target);
            track('section_view', { section: id });
          });
        },
        { threshold: 0.4 }
      );
      document.querySelectorAll('section[id]').forEach((s) => sectionViews.observe(s));
    </script>
    <script>
      const header = document.querySelector('.header');
      const menuBtn = document.querySelector('.mobile-menu-btn');
      const navLinks = document.querySelector('.nav-links');

      // Desktop: hide on scroll down, reveal on scroll up (the "headroom" pattern), with
      // the header only position: fixed while it's actually on screen:
      //   static: sits at the top of the page and scrolls away with it
      //   pinned: fixed, slid in after the reader scrolls back up
      // Phones/tablets: the header never pins. iOS Safari tints the status bar solid for the
      // rest of the visit once a fixed element shows near the top, so staying in the page
      // keeps the status bar transparent. Tapping the status bar scrolls back to it.
      if (header) {
        const compact = window.matchMedia('(max-width: 1024px)');
        const JITTER = 8;
        let lastY = window.scrollY;
        let ticking = false;
        const isPinned = () => header.classList.contains('is-pinned');
        const menuOpen = () => !!navLinks && navLinks.classList.contains('open');

        const pin = () => {
          header.classList.add('is-pinned', 'is-hidden');
          header.getBoundingClientRect();
          header.classList.remove('is-hidden');
        };
        const unpinAfterSlide = () => {
          header.classList.add('is-hidden');
          const done = (e) => {
            if (e && e.propertyName !== 'transform') return;
            header.removeEventListener('transitionend', done);
            if (header.classList.contains('is-hidden')) header.classList.remove('is-pinned', 'is-hidden');
          };
          header.addEventListener('transitionend', done);
          setTimeout(done, 500);
        };

        const update = () => {
          ticking = false;
          const y = Math.max(window.scrollY, 0);
          header.classList.toggle('scrolled', y > 40);
          if (compact.matches) {
            header.classList.remove('is-pinned', 'is-hidden');
            lastY = y;
            return;
          }
          // Back at the very top a pinned header lines up with its static spot, so drop
          // the fixed position without any visible change.
          if (y <= 0 && isPinned()) header.classList.remove('is-pinned', 'is-hidden');
          const delta = y - lastY;
          if (Math.abs(delta) < JITTER) return;
          lastY = y;
          const hidden = header.classList.contains('is-hidden');
          if (delta < 0) {
            if (!isPinned() && y > header.offsetHeight) pin();
            else if (hidden) header.classList.remove('is-hidden');
          } else if (isPinned() && !hidden && !menuOpen() && !header.contains(document.activeElement)) {
            unpinAfterSlide();
          }
        };
        window.addEventListener('scroll', () => {
          if (!ticking) { ticking = true; requestAnimationFrame(update); }
        }, { passive: true });
        // Keyboard users tabbing into a scrolled-away header get it back in view.
        header.addEventListener('focusin', () => {
          if (compact.matches) return;
          if (!isPinned() && window.scrollY > header.offsetHeight) pin();
          else header.classList.remove('is-hidden');
        });
      }

      if (menuBtn && navLinks) {
        menuBtn.setAttribute('aria-expanded', 'false');
        menuBtn.addEventListener('click', () => {
          const open = navLinks.classList.toggle('open');
          menuBtn.textContent = open ? '✕' : '☰';
          menuBtn.setAttribute('aria-expanded', String(open));
        });
        navLinks.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            navLinks.classList.remove('open');
            menuBtn.textContent = '☰';
            menuBtn.setAttribute('aria-expanded', 'false');
          });
        });
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );

      document.querySelectorAll('.fade-in').forEach((el) => observer.observe(el));

      // Active nav link highlighting — page-based (privacy, terms)
      document.querySelectorAll<HTMLAnchorElement>('.nav-links a:not([href*="#"])').forEach(a => {
        const linkPath = new URL(a.href).pathname;
        if (linkPath !== '/' && window.location.pathname === linkPath) {
          a.classList.add('nav-active');
        }
      });

      // Active nav link highlighting — hash-based (sections)
      const navAnchors = document.querySelectorAll<HTMLAnchorElement>('.nav-links a[href*="#"]');
      const sections = Array.from(navAnchors)
        .map(a => {
          const id = a.getAttribute('href')!.split('#')[1];
          return id ? document.getElementById(id) : null;
        })
        .filter(Boolean) as HTMLElement[];

      const setActiveLink = (id: string) => {
        navAnchors.forEach(a => {
          const href = a.getAttribute('href') ?? '';
          a.classList.toggle('nav-active', href.includes(`#${id}`));
        });
      };

      const sectionObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) setActiveLink(entry.target.id);
          });
        },
        { rootMargin: '-40% 0px -55% 0px', threshold: 0 }
      );

      sections.forEach(s => sectionObserver.observe(s));

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // <details> opens and closes instantly on its own, so drive the panel
      // height ourselves. Closing is deferred until the animation finishes,
      // otherwise the content would vanish before it could collapse.
      document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach(details => {
        const summary = details.querySelector('summary');
        const panel = details.querySelector<HTMLElement>('.faq-answer');
        if (!summary || !panel) return;

        let animation: Animation | null = null;
        let closing = false;

        summary.addEventListener('click', event => {
          if (prefersReducedMotion) return;
          event.preventDefault();

          // Measured before cancelling, so an interrupted animation resumes
          // from where it actually is instead of snapping.
          const from = panel.offsetHeight;
          animation?.cancel();

          // Mid-collapse the element is still `open`, but the intent is to reopen.
          if (details.open && !closing) {
            closing = true;
            animation = panel.animate(
              { height: [`${from}px`, '0px'], opacity: [1, 0] },
              { duration: 220, easing: 'cubic-bezier(0.4, 0, 0.2, 1)' }
            );
            animation.onfinish = () => {
              details.open = false;
              closing = false;
              animation = null;
            };
          } else {
            details.open = true;
            closing = false;
            const to = panel.offsetHeight;
            animation = panel.animate(
              { height: [`${from}px`, `${to}px`], opacity: [to ? from / to : 0, 1] },
              { duration: 260, easing: 'cubic-bezier(0.4, 0, 0.2, 1)' }
            );
            animation.onfinish = () => {
              animation = null;
            };
          }
        });
      });

      document.querySelectorAll<HTMLElement>('[data-tour]').forEach(section => {
        type DeviceKind = 'mobile' | 'desktop';

        const deviceBtns = Array.from(
          section.querySelectorAll<HTMLElement>('[data-tour-device]')
        );
        let device: DeviceKind =
          (deviceBtns[0]?.getAttribute('data-tour-device') as DeviceKind) ?? 'mobile';

        const itemsFor = (kind: DeviceKind) =>
          Array.from(section.querySelectorAll<HTMLElement>(`[data-tour-pick="${kind}"]`));
        const listFor = (kind: DeviceKind) =>
          section.querySelector<HTMLElement>(`[data-tour-list="${kind}"] .tour-list`);
        const caption = section.querySelector<HTMLElement>('[data-tour-caption]');

        // Only the selected item's group is listed; picking an item in another group
        // (auto-advance crossing a boundary) switches the group tab with it.
        // The gold bar under the group tabs is one element slid to the active tab, so a
        // switch reads as moving along, not as one underline vanishing and another
        // appearing. A hidden list measures zero, so it is placed again when shown.
        function placeIndicator(kind: DeviceKind) {
          const tabs = section.querySelector<HTMLElement>(`[data-tour-list="${kind}"] .tour-groups`);
          const active = tabs?.querySelector<HTMLElement>('.tour-group.active');
          if (!tabs || !active || !active.offsetWidth) return;
          tabs.style.setProperty('--ind-x', `${active.offsetLeft}px`);
          tabs.style.setProperty('--ind-w', String(active.offsetWidth));
          tabs.classList.add('has-indicator');
        }

        function showGroup(kind: DeviceKind, group: string) {
          section
            .querySelectorAll<HTMLElement>(`[data-tour-list="${kind}"] [data-tour-group]`)
            .forEach(tab => {
              const on = tab.dataset.tourGroup === group;
              tab.classList.toggle('active', on);
              tab.setAttribute('aria-pressed', String(on));
            });
          let shown = 0;
          itemsFor(kind).forEach(item => {
            const wasHidden = item.hidden;
            item.hidden = item.dataset.group !== group;
            item.classList.remove('tour-item-in');
            if (!item.hidden && wasHidden && !prefersReducedMotion) {
              item.style.setProperty('--i', String(shown));
              void item.offsetWidth;
              item.classList.add('tour-item-in');
            }
            if (!item.hidden) shown++;
          });
          placeIndicator(kind);
        }

        function select(kind: DeviceKind, index: number) {
          let picked: HTMLElement | undefined;
          itemsFor(kind).forEach(item => {
            const on = Number(item.dataset.index) === index;
            item.classList.toggle('active', on);
            item.setAttribute('aria-pressed', String(on));
            if (on) picked = item;
          });
          if (picked) {
            showGroup(kind, picked.dataset.group ?? '');
            if (caption && kind === device) {
              caption.textContent = picked.querySelector('.tour-item-body')?.textContent ?? '';
            }
          }

          section
            .querySelectorAll<HTMLElement>(`[data-tour-pane="${kind}"] .tour-screen`)
            .forEach(screen => {
              const on = Number(screen.dataset.index) === index;
              screen.classList.toggle('active', on);
              // Restart the entrance animation on every swap.
              if (on) {
                screen.classList.remove('tour-screen-in');
                void screen.offsetWidth;
                screen.classList.add('tour-screen-in');
              }
            });
        }

        // Phones lay the list out as a sideways chip row; keep the picked chip in view
        // without scrolling the page. On wider screens the list doesn't scroll at all.
        function scrollListTo(kind: DeviceKind, item: HTMLElement) {
          const list = listFor(kind);
          if (!list || list.scrollWidth <= list.clientWidth) return;
          list.scrollTo({
            left: item.offsetLeft - list.offsetLeft - list.clientWidth / 2 + item.clientWidth / 2,
            behavior: prefersReducedMotion ? 'auto' : 'smooth',
          });
        }

        function setDevice(kind: DeviceKind) {
          device = kind;
          deviceBtns.forEach(btn => {
            const on = btn.getAttribute('data-tour-device') === kind;
            btn.classList.toggle('active', on);
            btn.setAttribute('aria-pressed', String(on));
          });
          section.querySelectorAll<HTMLElement>('[data-tour-list]').forEach(el => {
            el.hidden = el.getAttribute('data-tour-list') !== kind;
          });
          section.querySelectorAll<HTMLElement>('[data-tour-pane]').forEach(el => {
            el.hidden = el.getAttribute('data-tour-pane') !== kind;
          });
          const active = itemsFor(kind).find(i => i.classList.contains('active'));
          if (caption && active) {
            caption.textContent = active.querySelector('.tour-item-body')?.textContent ?? '';
          }
          placeIndicator(kind);
        }

        (['mobile', 'desktop'] as DeviceKind[]).forEach(kind => {
          itemsFor(kind).forEach(item => {
            item.setAttribute('aria-pressed', String(item.classList.contains('active')));
            item.addEventListener('click', () => {
              select(kind, Number(item.dataset.index));
              scrollListTo(kind, item);
            });
          });
          section
            .querySelectorAll<HTMLElement>(`[data-tour-list="${kind}"] [data-tour-group]`)
            .forEach(tab => {
              tab.setAttribute('aria-pressed', String(tab.classList.contains('active')));
              tab.addEventListener('click', () => {
                const first = itemsFor(kind).find(i => i.dataset.group === tab.dataset.tourGroup);
                if (!first) return;
                select(kind, Number(first.dataset.index));
                scrollListTo(kind, first);
              });
            });
        });

        placeIndicator(device);
        window.addEventListener('resize', () => placeIndicator(device));
        document.fonts?.ready.then(() => placeIndicator(device));

        deviceBtns.forEach(btn => {
          btn.setAttribute('aria-pressed', String(btn.classList.contains('active')));
          btn.addEventListener('click', () =>
            setDevice(btn.getAttribute('data-tour-device') as DeviceKind)
          );
        });

        let autoTimer: ReturnType<typeof setInterval> | null = null;
        let userInteracted = false;
        let sectionInView = false;

        function stopAuto() {
          if (autoTimer) {
            clearInterval(autoTimer);
            autoTimer = null;
          }
        }

        function startAuto() {
          if (userInteracted || prefersReducedMotion || autoTimer) return;
          if (!sectionInView || document.visibilityState === 'hidden') return;
          autoTimer = setInterval(() => {
            const items = itemsFor(device);
            if (items.length === 0) return;
            const current = items.findIndex(i => i.classList.contains('active'));
            const next = (current + 1) % items.length;
            select(device, next);
            scrollListTo(device, items[next]);
          }, 4000);
        }

        section.addEventListener('pointerdown', () => {
          userInteracted = true;
          stopAuto();
        });

        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'hidden') stopAuto();
          else startAuto();
        });

        const autoObserver = new IntersectionObserver(
          entries => {
            entries.forEach(entry => {
              sectionInView = entry.isIntersecting;
              if (entry.isIntersecting) startAuto();
              else stopAuto();
            });
          },
          { threshold: 0.35 }
        );
        autoObserver.observe(section);
      });
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
