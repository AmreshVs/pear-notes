const bentoCards = [
  { title: 'Background sync', body: 'Devices catch up without you opening anything — periodically on mobile, from the tray on desktop.', icon: icons.sync },
  { title: 'Offline first', body: 'Works with no internet at all. Everything stored locally, encrypted.', icon: icons.layers },
];

const bentoCardsBottom = [
  { title: 'Media on your terms', body: 'Hold photo and file transfers on cellular, or pause them. Notes keep syncing either way.', icon: icons.pause },
  { title: 'Live transfer queue', body: 'Every upload and download shows progress. Pause, resume, cancel, or retry any of them.', icon: icons.transfer },
  { title: 'Pinned notes', body: 'Pin what matters and it stays on top, on every device you sync.', icon: icons.pin },
  { title: 'Write, speak, or scan', body: 'Rich text, voice memos with waveforms, and a document scanner — all landing in the encrypted vault.', icon: icons.pencil },
  { title: 'Every change, attributed', body: 'An activity log records what each device created, edited, or deleted — with the exact lines that changed.', icon: icons.history },
  { title: 'Share straight into a note', body: 'Send photos, files, links, or text from any other app and Pear Notes drops them into the note you pick.', icon: icons.share },
  { title: 'A 30-day safety net', body: 'Deleted notes wait in Recently Deleted for 30 days, on every device, before they are gone for good.', icon: icons.restore },
  { title: 'See it before you open it', body: 'The notes list previews images and the first page of a PDF, so you recognize a note without opening it.', icon: icons.image },
];

const aiHero = {
  title: 'Ask a note anything',
  body: "Ask a question and get an answer from that note alone. Ask for a change and you get the exact edits, listed, to apply or throw away. Nothing is rewritten behind your back — and nothing is sent anywhere.",
};

const aiFeatures = [
  { title: 'Voice typing', body: 'Speak and the words appear in the note as you talk. Your voice is turned into text on the device.', icon: icons.mic },
  { title: 'Transcribe recordings', body: 'Turn any voice memo into text, transcribed on the device and inserted as a quote under the recording.', icon: icons.transcript },
  { title: 'Extract text', body: 'Read the text out of photos, scans, and PDFs in 27 Latin-script languages — up to 20 pages, none of them uploaded.', icon: icons.scanText },
  { title: 'Describe images', body: 'A short description of a photo, written on the device and added as a caption below the image.', icon: icons.image },
  { title: 'Translate notes', body: '48 languages, to and from English. Each one is a 13–44 MB download, then it translates offline.', icon: icons.globe },
  { title: 'Summarize and rewrite', body: 'Summaries, key points, and suggested titles for a whole note. Fix grammar, or make a selection shorter, clearer, more professional, or friendlier — every pass runs on your own hardware.', icon: icons.pencil, wide: true },
];

const aiProof = [
  { title: 'Off until you turn it on', body: 'Every feature is a separate switch, off by default. The setting is per device and never synced.', icon: icons.toggle },
  { title: 'One download, then offline', body: 'Models come over Wi-Fi once, then run with no network at all. Pause, resume, or delete them any time.', icon: icons.download },
  { title: 'No AI provider involved', body: "There is no API key, no account, and no request to send. Your notes never leave the device to be processed.", icon: icons.wifiOff },
  { title: 'Locked notes stay out of it', body: 'Every AI action disappears on a locked note. Nothing summarizes, translates, or reads it.', icon: icons.lock },
];

/* `name` matches the screenshot filename under src/assets/screenshots/<platform>/ */
const mobileFeatures = [
  { name: 'Folders', title: 'Folders', body: 'Create, rename, and organize notes into folders with drag-and-drop.', icon: icons.folder },
  { name: 'Notes-List', title: 'Notes List', body: 'Notes grouped by date, with pinned notes always on top.', icon: icons.list },
  { name: 'Full-Text-Search', title: 'Full-Text Search', body: 'Instant search across all notes with real-time filtering.', icon: icons.search },
  { name: 'Rich-Text-Editor', title: 'Rich Text Editor', body: 'Headings, lists, task lists, code blocks, blockquotes, and alignment.', icon: icons.pencil },
  { name: 'Ask-AI', title: 'Ask AI', body: 'Ask about a note and apply the exact edits it proposes — answered on your phone, never in the cloud.', icon: icons.chat },
  { name: 'AI-Tools', title: 'AI Tools', body: 'Summaries, key points, titles, and rewrites — all generated on the device, with nothing uploaded.', icon: icons.sparkles },
  { name: 'Voice-Typing', title: 'Voice Typing', body: 'Speak and the words land in the note as you talk. Your voice is transcribed on the device and never sent.', icon: icons.mic },
  { name: 'Translate', title: 'Translate', body: '48 languages, to and from English, translated offline on the device once the language is downloaded.', icon: icons.globe },
  { name: 'On-Device-AI', title: 'On-Device AI', body: 'Turn features on one at a time. Each model downloads once, then runs with no network at all.', icon: icons.toggle },
  { name: 'Document-Scanner', title: 'Document Scanner', body: 'Multi-page scanning with auto-crop, attach photos or videos.', icon: icons.camera },
  { name: 'Voice-Notes', title: 'Voice Notes', body: 'Record with waveform visualization, playback, and embed inside notes.', icon: icons.mic },
  { name: 'Lock-Note', title: 'Note Lock', body: 'Biometrics or a synced password — screenshots blocked while open.', icon: icons.lockDot },
  { name: 'Activity-Log', title: 'Activity Log', body: 'What each device created, edited, or deleted — with the exact lines that changed.', icon: icons.history },
  { name: 'Customization', title: 'Customization', body: '8 fonts, adjustable text size, and dark/light/system themes.', icon: icons.gear },
  { name: 'Linked-Devices', title: 'Linked Devices', body: 'View, rename, and manage all connected devices.', icon: icons.phone },
  { name: 'P2P-Device-Sync', title: 'P2P Device Sync', body: 'Hypercore-based sync with QR code pairing.', icon: icons.activity },
  { name: 'Fingerprint-Matching', title: 'Fingerprint Matching', body: 'Verify device identity keys during pairing.', icon: icons.fingerprint },
  { name: 'Encrypted-Backups', title: 'Encrypted Backups', body: 'AES-256 .pnbk export/import, sealed with a password.', icon: icons.shield },
  { name: 'Storage', title: 'Storage', body: 'Usage by media type, plus one-tap reclaim of space.', icon: icons.box },
];

const desktopFeatures = [
  { name: 'Three-Panel-Layout', title: 'Three-Panel Layout', body: 'Resizable folders sidebar, notes list, and editor that adapt to your workflow.', icon: icons.columns },
  { name: 'Rich-Text-Editor', title: 'Rich Text Editor', body: 'Syntax-highlighted code blocks, tables, media embeds, headings, and task lists.', icon: icons.pencil },
  { name: 'Ask-AI', title: 'Ask AI', body: 'Ask about a note or a selection and review every change before it applies — answered on your computer, not a server.', icon: icons.chat },
  { name: 'AI-Tools', title: 'AI Tools', body: 'Summaries, key points, titles, rewrites, and translation from the editor or the selection menu — nothing leaves the machine.', icon: icons.sparkles },
  { name: 'On-Device-AI', title: 'On-Device AI', body: 'Per-feature switches with model sizes and licences. Models run on your computer, with no account and no API key.', icon: icons.toggle },
  { name: 'Media-Preview', title: 'Media Preview', body: 'Fullscreen previews for images, PDFs, text, and audio — plus inline video playback.', icon: icons.image },
  { name: 'Lock-Note', title: 'Note Lock', body: 'Touch ID, Windows Hello, or a synced password — with screen capture blocked while a locked note is open.', icon: icons.lockDot },
  { name: 'Voice-Recorder', title: 'Voice Recorder', body: 'Web Audio API recording with preview playback, saved as WebM audio.', icon: icons.mic },
  { name: 'Activity-Log', title: 'Activity Log', body: 'A timeline of every device\u2019s changes, with a line-by-line diff behind each entry.', icon: icons.history },
  { name: 'Customization', title: 'Customization', body: '8 fonts, adjustable size 12-24px, system/light/dark themes, and sorting by date or title.', icon: icons.gear },
  { name: 'Linked-Devices', title: 'Linked Devices', body: 'View, rename, and manage connected devices with platform info and sync status.', icon: icons.phone },
  { name: 'P2P-Device-Sync', title: 'P2P Device Sync', body: 'Hyperswarm discovery with QR code invites — temporary or permanent links.', icon: icons.activity },
  { name: 'Fingerprint-Matching', title: 'Fingerprint Matching', body: 'Verify device identity keys during pairing to prevent man-in-the-middle attacks.', icon: icons.fingerprint },
  { name: 'Encrypted-Backups', title: 'Encrypted Backups', body: 'AES-256-GCM .pnbk files sealed with a strong password — nothing stored, nothing recoverable without it.', icon: icons.shield },
  { name: 'Storage-Analytics', title: 'Storage Analytics', body: 'Usage broken down by media type, plus one-tap reclaim of space.', icon: icons.box },
];

const securityCards = [
  { title: 'Cryptographic pairing', body: 'Blind pairing handshake via QR invites, with fingerprint verification against man-in-the-middle attacks.', icon: icons.qr },
  { title: 'Encrypted media vault', body: 'An isolated streaming server renders attachments without leaking unencrypted caches.', icon: icons.box },
  { title: 'Locked stays locked', body: 'Failed attempts trigger exponential backoff, so brute force gets slower, not luckier.', icon: icons.shieldCheck },
  { title: 'Invisible to capture', body: 'Screenshots blocked and content hidden in the task switcher while a note is open.', icon: icons.eyeOff },
];

const steps = [
  { step: '01', title: 'Your device encrypts', body: 'Every note is encrypted locally before it ever leaves the device. Only your paired devices hold the keys.', icon: icons.lock },
  { step: '02', title: 'Devices find each other', body: "Hyperswarm's DHT locates your paired devices, then opens a direct, Noise-encrypted connection between them.", icon: icons.radio },
  { step: '03', title: 'Changes replicate', body: 'Hypercore append-only logs replicate over that connection. Nothing is stored or relayed by anyone in between.', icon: icons.refresh },
];

const faqs = [
  {
    id: 'faq-ai',
    q: 'Does the AI send my notes anywhere?',
    a: "No. Every AI feature runs on the device with a model you download once, so there is no API key, no account, and no request to send. Each feature is off until you turn it on, the setting stays on that device, and AI actions are hidden entirely on locked notes.",
  },
  {
    id: 'faq-sync',
    q: 'If there are no servers, how does sync actually work?',
    a: 'Your devices find each other through the Hyperswarm distributed network and open a direct, end-to-end encrypted connection — no middleman ever stores or relays your notes. Changes replicate immediately when two devices are online together; otherwise every edit waits safely on the device where you made it.',
  },
  {
    q: 'What happens if I lose my phone?',
    a: "If you have another paired device, pair a new device to it and you're back. Otherwise, restore from an encrypted .pnbk backup with your backup password. Without either, the data is gone: there's no server copy to recover from, by design.",
  },
  {
    q: 'What if I forget my backup password?',
    a: "There is no reset. The backup's encryption key is derived from your password, and we never see either. Treat your backup password like the keys to a safe.",
  },
  {
    q: 'Do you really collect nothing?',
    a: 'Really. No accounts, no analytics, no crash reporters, no ads, no tracking pixels. The app has no servers of ours to talk to, so there’s nowhere for your data to go.',
  },
];
---

<Layout
  title="Pear Notes — Private & Encrypted Notes with P2P Sync and On-Device AI"
  description="Pear Notes is a secure, private, offline-first notebook. End-to-end encrypted with peer-to-peer sync across your devices, plus on-device AI for voice typing, transcripts, summaries and translation. No servers, no cloud, nothing uploaded."
>
  <Header />

  <!-- Hero -->
  <section class="hero" id="top">
    <div class="hero-aurora" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-dots" aria-hidden="true"></div>

    <div class="hero-inner">
      <div class="hero-copy">
        <h1>
          Your notes,<br />
          <span class="gradient-text">truly private.</span>
        </h1>
        <p class="hero-subtitle">
          Encrypted notes that sync straight between your devices — and AI that runs on your own hardware. No servers. No cloud. No compromises.
        </p>
        <div class="hero-actions">
          <a href="#download" class="btn-primary">Get Pear Notes</a>
          <a href="#features" class="btn-secondary">Explore Features</a>
        </div>
        <div class="hero-platforms">
          <span class="platform-available">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6 18c0 .55.45 1 1 1h1v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h2v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h1c.55 0 1-.45 1-1V7H6v11zM3.5 7C2.67 7 2 7.67 2 8.5v7c0 .83.67 1.5 1.5 1.5S5 16.33 5 15.5v-7C5 7.67 4.33 7 3.5 7zm17 0c-.83 0-1.5.67-1.5 1.5v7c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5v-7c0-.83-.67-1.5-1.5-1.5zm-4.97-5.84l1.3-1.3c.2-.2.2-.51 0-.71-.2-.2-.51-.2-.71 0l-1.48 1.48A5.84 5.84 0 0 0 12 0c-.96 0-1.86.23-2.66.63L7.85.15c-.2-.2-.51-.2-.71 0-.2.2-.2.51 0 .71l1.31 1.31A5.983 5.983 0 0 0 6 6h12c0-2.21-1.2-4.15-2.97-5.19V1.16zM10 4H9V3h1v1zm5 0h-1V3h1v1z"/></svg>
            Android
          </span>
          <span class="platform-soon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83"/><path d="M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11"/></svg>
            iOS &middot; Soon
          </span>
          <span class="platform-soon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83"/><path d="M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11"/></svg>
            macOS &middot; Soon
          </span>
          <span class="platform-soon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801"/></svg>
            Windows &middot; Soon
          </span>
        </div>
      </div>

      <div class="hero-visual">
        <div class="p2p-scene" aria-label="Notes sync directly between your devices over an encrypted connection, bypassing the cloud">
          <svg class="p2p-links" viewBox="0 0 640 540" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <defs>
              <linearGradient id="beamGrad" x1="101" y1="400" x2="428" y2="300" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#DCA323" stop-opacity="0.5"/>
                <stop offset="0.5" stop-color="#F0C040"/>
                <stop offset="1" stop-color="#DCA323" stop-opacity="0.5"/>
              </linearGradient>
              <filter id="packetGlow" x="-200%" y="-200%" width="500%" height="500%">
                <feGaussianBlur stdDeviation="3" result="blur"/>
                <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>
              <mask id="cloudMask">
                <rect width="100%" height="100%" fill="white"/>
                <circle cx="165" cy="95" r="38" fill="black"/>
              </mask>
            </defs>
            <g class="p2p-cloud">
              <g class="p2p-cloud-icon">
                <circle cx="165" cy="95" r="32" fill="rgba(255,255,255,0.02)" stroke="rgba(255,255,255,0.08)" stroke-width="1"/>
                <g transform="translate(147, 77) scale(1.5)">
                  <path
                    d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z"
                    fill="none"
                    stroke="rgba(160,160,165,0.8)"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </g>
                <line class="p2p-strike" x1="149" y1="111" x2="181" y2="79" stroke="rgba(232,137,127,0.7)" stroke-width="1.75" stroke-linecap="round"/>
              </g>
              <path class="p2p-cloud-link" d="M 51 250 A 190 190 0 0 1 395 160" stroke="#6e6e73" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="7 9" opacity="0.5" fill="none" mask="url(#cloudMask)"/>
            </g>
            <path id="p2pPath" class="p2p-beam" d="M 101 400 A 190 190 0 0 0 428 300" stroke="url(#beamGrad)" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="7 9" fill="none"/>
            <g class="p2p-packets" filter="url(#packetGlow)">
              <circle r="4.5" fill="#F0C040">
                <animateMotion dur="2.8s" repeatCount="indefinite" calcMode="linear">
                  <mpath href="#p2pPath"/>
                </animateMotion>
              </circle>
              <circle r="4.5" fill="#F0C040">
                <animateMotion dur="2.8s" repeatCount="indefinite" calcMode="linear" keyPoints="1;0" keyTimes="0;1">
                  <mpath href="#p2pPath"/>
                </animateMotion>
              </circle>
            </g>
          </svg>

          <div class="p2p-device p2p-laptop">
            <LaptopFrame>
              <Screenshot dir="Desktop" name="Three-Panel-Layout" alt="Pear Notes desktop three-panel layout" width={1400} loading="eager" />
            </LaptopFrame>
            <span class="sync-badge sync-badge-laptop" aria-hidden="true">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#08080a" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
          </div>

          <div class="p2p-device p2p-phone">
            <PhoneFrame device="iphone" radius="15px" loading="eager">
              <Screenshot dir="iOS" name="Notes-List" alt="Pear Notes notes list" loading="eager" />
            </PhoneFrame>
            <span class="sync-badge sync-badge-phone" aria-hidden="true">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#08080a" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
          </div>

          <div class="p2p-lock-pill">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#DCA323" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            End-to-end encrypted
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features bento -->
  <section class="features" id="features">
    <div class="container">
      <div class="section-head fade-in">
        <div class="section-label">Features</div>
        <h2 class="section-title">Everything you need,<br />nothing you don't.</h2>
        <p class="section-subtitle">A complete writing experience built around privacy.</p>
      </div>

      <div class="bento fade-in">
        <article class="bento-card bento-card-hero">
          <h3>Locked, on-device, always</h3>
          <p>Notes are encrypted with AES-256 before they touch storage. Lock any one of them behind Face ID, Touch ID, Windows Hello, or a synced password.</p>
          <div class="bento-hero-art" aria-hidden="true">
            <div class="bento-hero-halo"></div>
            <div class="bento-hero-well">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#DCA323" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/><circle cx="12" cy="16" r="1.4" fill="#DCA323" stroke="none"/></svg>
            </div>
          </div>
        </article>

        {bentoCards.map(card => (
          <article class="bento-card">
            <span class="bento-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#DCA323" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={card.icon} />
            </span>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))}

        <article class="bento-card bento-card-wide">
          <span class="bento-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#DCA323" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons.shieldCheck} />
          </span>
          <h3>Sealed backups</h3>
          <p>Export the vault as one .pnbk file, sealed with a password only you know — and restore it on any device to get everything back.</p>
          <div class="backup-flow" aria-hidden="true">
            <span class="backup-node">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#DCA323" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons.lock} />
            </span>
            <svg class="backup-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6e6e73" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            <span class="backup-file">
              <span class="backup-file-ext">.pnbk</span>
              <span class="backup-file-line"></span>
              <span class="backup-file-line short"></span>
              <span class="backup-file-seal">
                <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#DCA323" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons.lock} />
              </span>
            </span>
            <svg class="backup-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6e6e73" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            <span class="backup-node">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#DCA323" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons.phone} />
            </span>
          </div>
        </article>

        {bentoCardsBottom.map(card => (
          <article class="bento-card">
            <span class="bento-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#DCA323" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={card.icon} />
            </span>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- On-device AI -->
  <section class="ai" id="ai">
    <div class="container">
      <div class="section-head fade-in">
        <div class="section-label">On-device AI</div>
        <h2 class="section-title">AI that never<br />leaves your device.</h2>
        <p class="section-subtitle">Six optional features, each running on an open model you download once. After that they work with no network at all — there is no AI provider in the picture, because there is nowhere to send anything.</p>
      </div>

      <div class="ai-grid fade-in">
        <article class="ai-card ai-card-hero">
          <span class="ai-icon ai-icon-lg" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#DCA323" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons.chat} />
          </span>
          <h3>{aiHero.title}</h3>
          <p>{aiHero.body}</p>
          <div class="ask-demo" aria-hidden="true">
            <div class="ask-bubble ask-bubble-you">Move the standup to Friday and add Sam</div>
            <div class="ask-edits">
              <span class="ask-edits-title">2 changes to the note</span>
              <span class="ask-edit">
                <span class="ask-edit-old">Monday</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#6e6e73" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                <span class="ask-edit-new">Friday</span>
              </span>
              <span class="ask-edit">
                <span class="ask-edit-old">Anna, Ben</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#6e6e73" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                <span class="ask-edit-new">Anna, Ben, Sam</span>
              </span>
              <span class="ask-apply">Apply changes</span>
            </div>
          </div>
        </article>

        {aiFeatures.map(f => (
          <article class:list={['ai-card', { 'ai-card-wide': f.wide }]}>
            <span class="ai-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#DCA323" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={f.icon} />
            </span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))}
      </div>

      <div class="ai-proof fade-in">
        {aiProof.map(item => (
          <div class="ai-proof-item">
            <span class="ai-proof-icon" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#DCA323" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
            </span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </div>
        ))}
      </div>

      <p class="ai-note">
        Models are open and named in the app, with their licences — Whisper (MIT), Qwen3 and VisionPsy (Apache&nbsp;2.0), Bergamot (MPL&nbsp;2.0).
        On-device AI needs a physical device running iOS&nbsp;17, Android&nbsp;12, or macOS&nbsp;14 or later, and the models it downloads are left out of backups and sync.
      </p>
    </div>
  </section>

  <!-- Interactive tour -->
  <section class="tour" id="tour" data-tour>
    <div class="container">
      <div class="section-head fade-in">
        <div class="section-label">Tour</div>
        <h2 class="section-title">Tap through the real app.</h2>
        <p class="section-subtitle">Every screen below is a live screenshot from the shipped build.</p>
      </div>

      <div class="tour-grid">
        <div class="tour-list-wrap" data-tour-list="mobile">
          <div class="tour-list">
            {mobileFeatures.map((f, i) => (
              <button class:list={['tour-item', { active: i === 0 }]} data-tour-pick="mobile" data-index={i} type="button">
                <span class="tour-item-icon" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#DCA323" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={f.icon} />
                </span>
                <span class="tour-item-text">
                  <span class="tour-item-title">{f.title}</span>
                  <span class="tour-item-body">{f.body}</span>
                </span>
              </button>
            ))}
          </div>
        </div>

        <div class="tour-list-wrap" data-tour-list="desktop" hidden>
          <div class="tour-list">
            {desktopFeatures.map((f, i) => (
              <button class:list={['tour-item', { active: i === 0 }]} data-tour-pick="desktop" data-index={i} type="button">
                <span class="tour-item-icon" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#DCA323" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={f.icon} />
                </span>
                <span class="tour-item-text">
                  <span class="tour-item-title">{f.title}</span>
                  <span class="tour-item-body">{f.body}</span>
                </span>
              </button>
            ))}
          </div>
        </div>

        <div class="tour-preview">
          <div class="platform-toggle">
            <button class="platform-toggle-btn active" data-tour-device="mobile" type="button">Mobile</button>
            <button class="platform-toggle-btn" data-tour-device="desktop" type="button">Desktop</button>
          </div>

          <div class="tour-phones" data-tour-pane="mobile">
            <PhoneFrame device="pixel" class="tour-phone tour-phone-pixel">
              {mobileFeatures.map((f, i) => (
                <div class:list={['tour-screen', { active: i === 0 }]} data-index={i}>
                  <Screenshot dir="Android" name={f.name} alt={`${f.title} — Android`} />
                </div>
              ))}
            </PhoneFrame>
            <PhoneFrame device="iphone" class="tour-phone tour-phone-iphone">
              {mobileFeatures.map((f, i) => (
                <div class:list={['tour-screen', { active: i === 0 }]} data-index={i}>
                  <Screenshot dir="iOS" name={f.name} alt={`${f.title} — iOS`} />
                </div>
              ))}
            </PhoneFrame>
          </div>

          <div class="tour-desktop" data-tour-pane="desktop" hidden>
            {desktopFeatures.map((f, i) => (
              <div class:list={['tour-screen', { active: i === 0 }]} data-index={i}>
                <Screenshot dir="Desktop" name={f.name} alt={`${f.title} — Desktop`} />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Security -->
  <section class="security" id="security">
    <div class="container">
      <div class="section-head fade-in">
        <div class="section-label">Security</div>
        <h2 class="section-title">Built for real privacy.</h2>
        <p class="section-subtitle">Zero-knowledge architecture means even we can't read your notes. Because we never see them.</p>
      </div>

      <div class="sec-grid fade-in">
        <article class="sec-card sec-card-hero">
          <div class="sec-card-decor" aria-hidden="true"></div>
          <span class="sec-icon sec-icon-lg" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#DCA323" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons.activity} />
          </span>
          <h3>No central servers</h3>
          <p>Hyperswarm discovery, direct connections, and encrypted Hypercore append-only logs — there's no server in the middle to compromise.</p>
          <div class="sec-status">
            <span class="sec-status-dot" aria-hidden="true"></span>
            Zero server dependencies
          </div>
        </article>

        {securityCards.map(card => (
          <article class="sec-card">
            <span class="sec-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#DCA323" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={card.icon} />
            </span>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- How sync works -->
  <section class="how-sync" id="how-it-works">
    <div class="container">
      <div class="section-head fade-in">
        <div class="section-label">How sync works</div>
        <h2 class="section-title">Three steps, zero servers.</h2>
      </div>

      <div class="steps fade-in">
        {steps.map(s => (
          <article class="step-card">
            <span class="step-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#DCA323" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
            </span>
            <span class="step-label">Step {s.step}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </article>
        ))}
      </div>

      <p class="steps-note">
        Want the full picture? Read the <a href="https://docs.pears.com/" target="_blank" rel="noopener noreferrer">Pear docs</a>
        or the <a href="https://heartit.tech/category/p2p-systems/" target="_blank" rel="noopener noreferrer">P2P from Scratch</a> series.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq" id="faq">
    <div class="faq-inner">
      <div class="section-head fade-in">
        <div class="section-label">FAQ</div>
        <h2 class="section-title">Questions, answered.</h2>
      </div>
      <div class="faq-list fade-in">
        {faqs.map(item => (
          <details class="faq-item" id={item.id}>
            <summary>
              {item.q}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="faq-answer"><p>{item.a}</p></div>
          </details>
        ))}
      </div>
      <a href={`${base}faq/`} class="faq-more-link">Browse all questions &rarr;</a>
    </div>
  </section>

  <!-- Download -->
  <section class="download" id="download">
    <div class="download-card fade-in">
      <div class="download-glow" aria-hidden="true"></div>
      <div class="download-content">
        <h2>Start writing privately.</h2>
        <p>Download Pear Notes for Android today. Your notes stay yours — encrypted on-device, synced peer-to-peer, and never uploaded — not even for AI.</p>
        <a href="https://play.google.com/store/apps/details?id=com.amreshvs.pearnotes" target="_blank" rel="noopener noreferrer" class="btn-primary btn-primary-lg">Get it on Google Play</a>
        <p class="download-note">iOS &middot; macOS &middot; Windows coming soon</p>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
