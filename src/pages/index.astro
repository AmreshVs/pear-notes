---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Screenshot from '../components/Screenshot.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const featureGroups = [
  {
    label: 'Privacy & Encryption',
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
    items: [
      {
        title: 'End-to-End Encrypted',
        body: 'Notes are encrypted on-device with AES-256. Your keys never leave your devices.',
        icon: '<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
      },
      {
        title: 'Note Lock',
        body: 'Lock individual notes behind Face ID, Touch ID, Windows Hello, or a synced password.',
        icon: '<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/><circle cx="12" cy="16" r="1"/>',
      },
      {
        title: 'Password-Protected Backups',
        body: 'Export your vault as a single encrypted .pnbk file, sealed with a password only you know.',
        icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9.5 11.5l2 2 3.5-3.5"/>',
      },
      {
        title: 'Offline First',
        body: 'Works entirely without internet. Everything is stored locally, encrypted, on your device.',
        icon: '<path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>',
      },
    ],
  },
  {
    label: 'Sync & Devices',
    icon: '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>',
    items: [
      {
        title: 'P2P Device Sync',
        body: 'Devices connect directly over encrypted channels using Hyperswarm and HyperDHT.',
        icon: '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>',
      },
      {
        title: 'Background Sync',
        body: 'Devices catch up without you opening anything — periodically on mobile, from the tray on desktop.',
        icon: '<polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>',
      },
      {
        title: 'Media on Your Terms',
        body: 'Hold photo and file transfers on cellular, or pause them. Notes keep syncing either way.',
        icon: '<circle cx="12" cy="12" r="10"/><line x1="10" y1="15" x2="10" y2="9"/><line x1="14" y1="15" x2="14" y2="9"/>',
      },
      {
        title: 'Live Transfer Queue',
        body: 'Every upload and download shows its progress. Pause, resume, cancel, or retry any of them.',
        icon: '<line x1="7" y1="20" x2="7" y2="4"/><polyline points="3 8 7 4 11 8"/><line x1="17" y1="4" x2="17" y2="20"/><polyline points="13 16 17 20 21 16"/>',
      },
    ],
  },
  {
    label: 'Writing & Capture',
    icon: '<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>',
    items: [
      {
        title: 'Rich Text Editor',
        body: 'Headings, lists, task lists, blockquotes, code blocks, tables, and text alignment.',
        icon: '<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>',
      },
      {
        title: 'Voice Notes',
        body: 'Record voice memos with waveform visualization and embed them inside your notes.',
        icon: '<path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/>',
      },
      {
        title: 'Document Scanner',
        body: 'Capture, crop, and convert physical pages into documents in your encrypted media vault.',
        icon: '<path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/>',
      },
      {
        title: 'Pinned Notes',
        body: 'Pin what matters and it stays at the top of every list, on every device you sync.',
        icon: '<path d="M12 17v5"/><path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"/>',
      },
    ],
  },
];
---

<Layout title="Pear Notes — Private & Encrypted Notes with P2P Sync">
  <div class="dot-grid"></div>
  <Header />

  <!-- Hero -->
  <section class="hero">
    <div class="hero-glow hero-glow-1"></div>
    <div class="hero-glow hero-glow-2"></div>
    <div class="hero-glow hero-glow-3"></div>
    <div class="hero-inner">
      <div class="hero-copy">
      <h1>
        Your notes,<br />
        <span class="gradient-text">truly private.</span>
      </h1>
      <p class="hero-subtitle">
        Encrypted notes that sync directly between your devices using peer-to-peer connections. No servers. No cloud. No compromises.
      </p>
      <div class="hero-actions">
        <a href="#download" class="btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Get Pear Notes
        </a>
        <a href="#features" class="btn-secondary">
          Explore Features
        </a>
      </div>
      <div class="hero-platforms">
        <span class="platform-available">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6 18c0 .55.45 1 1 1h1v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h2v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h1c.55 0 1-.45 1-1V7H6v11zM3.5 7C2.67 7 2 7.67 2 8.5v7c0 .83.67 1.5 1.5 1.5S5 16.33 5 15.5v-7C5 7.67 4.33 7 3.5 7zm17 0c-.83 0-1.5.67-1.5 1.5v7c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5v-7c0-.83-.67-1.5-1.5-1.5zm-4.97-5.84l1.3-1.3c.2-.2.2-.51 0-.71-.2-.2-.51-.2-.71 0l-1.48 1.48A5.84 5.84 0 0 0 12 0c-.96 0-1.86.23-2.66.63L7.85.15c-.2-.2-.51-.2-.71 0-.2.2-.2.51 0 .71l1.31 1.31A5.983 5.983 0 0 0 6 6h12c0-2.21-1.2-4.15-2.97-5.19V1.16zM10 4H9V3h1v1zm5 0h-1V3h1v1z"/></svg>
          Android
        </span>
        <span class="platform-soon">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83"/><path d="M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11"/></svg>
          iOS &middot; Soon
        </span>
        <span class="platform-soon">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83"/><path d="M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11"/></svg>
          macOS &middot; Soon
        </span>
        <span class="platform-soon">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801"/></svg>
          Windows &middot; Soon
        </span>
      </div>
      </div>
      <div class="hero-visual">
        <div class="p2p-scene" aria-label="Notes sync directly between your devices over an encrypted connection, bypassing the cloud">
          <svg class="p2p-links" viewBox="0 0 640 540" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <defs>
              <linearGradient id="beamGrad" x1="101" y1="400" x2="428" y2="300" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#DCA323" stop-opacity="0.5"/>
                <stop offset="0.5" stop-color="#F0C040"/>
                <stop offset="1" stop-color="#DCA323" stop-opacity="0.5"/>
              </linearGradient>
              <filter id="packetGlow" x="-200%" y="-200%" width="500%" height="500%">
                <feGaussianBlur stdDeviation="3" result="blur"/>
                <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>
              <mask id="cloudMask">
                <rect width="100%" height="100%" fill="white"/>
                <circle cx="165" cy="95" r="38" fill="black"/>
              </mask>
            </defs>
            <g class="p2p-cloud">
              <g class="p2p-cloud-icon">
                <circle cx="165" cy="95" r="32" fill="rgba(255,255,255,0.02)" stroke="rgba(255,255,255,0.08)" stroke-width="1"/>
                <g transform="translate(147, 77) scale(1.5)">
                  <path
                    d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z"
                    fill="none"
                    stroke="rgba(160,160,165,0.8)"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </g>
                <line class="p2p-strike" x1="149" y1="111" x2="181" y2="79" stroke="rgba(232,137,127,0.7)" stroke-width="1.75" stroke-linecap="round"/>
              </g>
              <path class="p2p-cloud-link" d="M 51 250 A 190 190 0 0 1 395 160" stroke="#6e6e73" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="7 9" opacity="0.5" fill="none" mask="url(#cloudMask)"/>
            </g>
            <path id="p2pPath" class="p2p-beam" d="M 101 400 A 190 190 0 0 0 428 300" stroke="url(#beamGrad)" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="7 9" fill="none"/>
            <g class="p2p-packets" filter="url(#packetGlow)">
              <circle r="4.5" fill="#F0C040">
                <animateMotion dur="2.8s" repeatCount="indefinite" calcMode="linear">
                  <mpath href="#p2pPath"/>
                </animateMotion>
              </circle>
              <circle r="3.5" fill="#e8b040" opacity="0.9" visibility="hidden">
                <set attributeName="visibility" to="visible" begin="1.4s"/>
                <animateMotion dur="2.8s" begin="1.4s" repeatCount="indefinite" calcMode="linear" keyPoints="1;0" keyTimes="0;1" fill="freeze">
                  <mpath href="#p2pPath"/>
                </animateMotion>
              </circle>
            </g>
          </svg>
          <div class="p2p-device p2p-laptop">
            <div class="mock-screen">
              <div class="mock-titlebar"><span></span><span></span><span></span></div>
              <div class="mock-columns">
                <div class="mock-sidebar">
                  <div class="bar gold w60"></div>
                  <div class="bar w80"></div>
                  <div class="bar w70"></div>
                  <div class="bar w50"></div>
                </div>
                <div class="mock-main">
                  <div class="bar bright w50"></div>
                  <div class="bar w90"></div>
                  <div class="bar w100"></div>
                  <div class="bar w80"></div>
                  <div class="bar gold w40"></div>
                  <div class="bar w70"></div>
                </div>
              </div>
              <div class="mock-sync-badge">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#08080a" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
            </div>
            <div class="laptop-base"></div>
          </div>
          <div class="p2p-device p2p-phone">
            <div class="mock-screen">
              <div class="mock-notch"></div>
              <div class="bar bright w60"></div>
              <div class="mock-card">
                <div class="bar gold w50"></div>
                <div class="bar w90"></div>
              </div>
              <div class="mock-card">
                <div class="bar bright w70"></div>
                <div class="bar w80"></div>
              </div>
              <div class="mock-card">
                <div class="bar bright w50"></div>
                <div class="bar w60"></div>
              </div>
              <div class="mock-sync-badge">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#08080a" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
            </div>
          </div>
          <div class="p2p-lock-pill">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#DCA323" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            End-to-end encrypted
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="features" id="features">
    <div class="container">
      <div class="features-header fade-in">
        <div class="section-label">Features</div>
        <h2 class="section-title">Everything you need,<br />nothing you don't.</h2>
        <p class="section-subtitle">
          A complete writing experience built around privacy.
        </p>
      </div>
      <div class="feature-panels">
        {featureGroups.map((group, gi) => (
          <section class={`feature-panel fade-in fade-in-delay-${gi + 1}`}>
            <header class="feature-panel-head">
              <span class="feature-panel-icon" aria-hidden="true">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={group.icon} />
              </span>
              <h3>{group.label}</h3>
            </header>
            <ul class="feature-panel-list">
              {group.items.map(item => (
                <li class="feature-point">
                  <span class="feature-point-icon" aria-hidden="true">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
                  </span>
                  <div class="feature-point-text">
                    <h4>{item.title}</h4>
                    <p>{item.body}</p>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>

  <div class="section-divider"></div>

  <!-- Mobile App Showcase -->
  <section class="app-showcase" id="mobile" data-section="mobile">
    <div class="container">
      <div class="app-showcase-header fade-in">
        <div class="app-showcase-header-text">
          <div class="section-label">Mobile App</div>
          <h2 class="section-title">Notes on the go,<br />always secure.</h2>
          <p class="section-subtitle">Capture thoughts with voice recording, document scanning, and a Tiptap-powered rich text editor.</p>
        </div>
      </div>
      <div class="app-showcase-body">
        <div class="feature-list-wrap">
        <div class="feature-list">
          <button class="feature-item active" data-feature="folders">
            <div class="feature-item-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#DCA323" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
            </div>
            <div class="feature-item-text">
              <h4>Folders</h4>
              <p>Create, rename, and organize notes into folders with drag-and-drop support.</p>
            </div>
          </button>
          <button class="feature-item" data-feature="notes-list">
            <div class="feature-item-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#DCA323" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
            </div>
            <div class="feature-item-text">
              <h4>Notes List</h4>
              <p>Notes grouped by date — today, yesterday, last 7 days — with pinned notes always on top.</p>
            </div>
          </button>
          <button class="feature-item" data-feature="search">
            <div class="feature-item-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#DCA323" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </div>
            <div class="feature-item-text">
              <h4>Full-Text Search</h4>
              <p>Instant search across all notes with real-time filtering and results.</p>
            </div>
          </button>
          <button class="feature-item" data-feature="editor">
            <div class="feature-item-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#DCA323" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            </div>
            <div class="feature-item-text">
              <h4>Rich Text Editor</h4>
              <p>Headings, lists, task lists, code blocks, blockquotes, links, and text alignment.</p>
            </div>
          </button>
          <button class="feature-item" data-feature="scanner">
            <div class="feature-item-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#DCA323" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
            </div>
            <div class="feature-item-text">
              <h4>Document Scanner</h4>
              <p>Multi-page scanning, auto-crop, and attach photos or videos from camera.</p>
            </div>
          </button>
          <button class="feature-item" data-feature="voice">
            <div class="feature-item-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#DCA323" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
            </div>
            <div class="feature-item-text">
              <h4>Voice Notes</h4>
              <p>Record with waveform visualization, playback, and embed directly inside notes.</p>
            </div>
          </button>
          <button class="feature-item" data-feature="lock">
            <div class="feature-item-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#DCA323" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/><circle cx="12" cy="16" r="1"/></svg>
            </div>
            <div class="feature-item-text">
              <h4>Note Lock</h4>
              <p>Lock notes behind biometrics or a synced password. Screenshots and the app switcher are blocked while a locked note is open.</p>
            </div>
          </button>
          <button class="feature-item" data-feature="customize">
            <div class="feature-item-icon">
